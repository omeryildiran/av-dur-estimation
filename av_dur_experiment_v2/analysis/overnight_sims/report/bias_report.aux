\@writefile{toc}{\contentsline {section}{\numberline {2}Results}{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}$c$ is not identified}{3}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Recovered vs true $c$, from the fit with $c$ and $d$ free, by the generating model; $\sigma _A$ known (log error 0.15). The other scenarios look the same: $r$ between $-0.11$ and $0.38$, RMSE 0.40--0.67 against a true SD of 0.14. Values beyond $\pm $0.8 are at the bounds.}}{3}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}$d$: fusion observers only, and only with precise $\sigma $s}{3}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Recovered vs true $d$ (fit with $c$ and $d$ free). Rows: what is known about $\sigma _A$. Only fusion observers with precisely known $\sigma $s give a usable $d$. The $d$-only fit gives the same picture (fusion $r$ = 0.44 / 0.65 / 0.83 across the three scenarios) and underestimates $d$ for CI observers by 0.21--0.26 on average.}}{3}{figure.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Model recovery}{4}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Right model by AIC. ``Best of all'' picks among all nine fits (3 models $\times $ 3 bias variants). Chance is 33\%.}}{4}{figure.caption.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Right model by AIC, \% (115--116 participants per model; the SE of a single cell is about 3--4 points).}}{4}{table.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:modelrec}{{1}{4}{Right model by AIC, \% (115--116 participants per model; the SE of a single cell is about 3--4 points)}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}$p_c$}{5}{subsection.2.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces $p_c$ recovered by the CI fit for CI participants (true SD 0.25). Mean $p_c$ error of the no-bias fit by true $d$ ($\sigma _A$ known, 0.15): $-0.12$ for $d < 0$, $-0.02$ for $0 \le d \le 0.3$, $+0.02$ for $d > 0.3$. The $d$ fit halves the first ($-0.06$) without lowering the RMSE.}}{5}{table.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Noise calibration and presentation order}{5}{section.3}\protected@file@percent }
\newlabel{sec:order}{{3}{5}{Noise calibration and presentation order}{section.3}{}}
\@writefile{toc}{\contentsline {paragraph}{What happens.}{5}{section*.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Calibration: \% correct at $\pm $0.41 (332/752\,ms) within a factor of 1.4 of the chosen level. Unimodal block: lognormal fits per order (lapse $\le 0.1$). Very large or very small $\sigma $s are poorly determined, because QUEST+ placed those tests at the extremes. P102's unimodal block at the calibrated level was stopped after 8 trials. In a joint fit of all of P102's data, P102 is the one symmetric listener ($\sigma $ 0.60 vs 0.56 at noise 0.5).}}{5}{table.caption.9}\protected@file@percent }
\newlabel{tab:order}{{3}{5}{Calibration: \% correct at $\pm $0.41 (332/752\,ms) within a factor of 1.4 of the chosen level. Unimodal block: lognormal fits per order (lapse $\le 0.1$). Very large or very small $\sigma $s are poorly determined, because QUEST+ placed those tests at the extremes. P102's unimodal block at the calibrated level was stopped after 8 trials. In a joint fit of all of P102's data, P102 is the one symmetric listener ($\sigma $ 0.60 vs 0.56 at noise 0.5)}{table.caption.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Why the calibration overshot.}{5}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Starting point, trials and a cap.}{5}{section*.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Median level reached (80\% range for P105). More trials do not help, the start point helps a little, and the cap does most of the work. The calibration summary now also reports \% correct by order near the chosen level, and warns if test-first is below 60\% and more than 25 points behind test-second.}}{6}{table.caption.12}\protected@file@percent }
