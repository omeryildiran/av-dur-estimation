\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{biorxiv}[2026/08/19 Clean bioRxiv preprint styling]

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\IfFileExists{microtype.sty}{\RequirePackage{microtype}}{}

\definecolor{biorxivblue}{HTML}{176B87}
\definecolor{biorxivgray}{HTML}{5C6670}
\definecolor{biorxivlight}{HTML}{EEF5F7}

\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\setlength{\columnsep}{0.3in}
\setlength{\emergencystretch}{2em}
\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{2}

\makeatletter
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-2.6ex \@plus -0.8ex \@minus -0.2ex}%
  {1.1ex \@plus 0.2ex}%
  {\normalfont\Large\bfseries\color{biorxivblue}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2.2ex \@plus -0.6ex \@minus -0.2ex}%
  {0.8ex \@plus 0.2ex}%
  {\normalfont\large\bfseries}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
  {0.6ex \@plus 0.2ex}%
  {\normalfont\normalsize\bfseries\itshape}}

\providecommand{\captionfonts}{\normalfont\small}
\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  \captionfonts\noindent\textbf{#1.} #2\par
  \vskip\belowcaptionskip}

\def\ps@biorxiv{%
  \def\@oddhead{\small\color{biorxivgray}\textit{Preprint -- not peer reviewed}\hfill\thepage}%
  \let\@evenhead\@oddhead
  \def\@oddfoot{}\let\@evenfoot\@oddfoot}
\pagestyle{biorxiv}
\makeatother

\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.85}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.88}
\setcounter{topnumber}{4}
\setcounter{bottomnumber}{3}
\setcounter{totalnumber}{6}
