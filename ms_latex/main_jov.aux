\@LN@col{1}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Group-level model preference with participant bootstrap.} Mean per-participant $\Delta $AIC relative to the forced-fusion model (baseline $=0$, not shown) under fixed (left) and free (right) sensory noise. Black markers show the mean across participants with 95\% confidence intervals from $10{,}000$ participant bootstrap resamples; coloured points show individual participants. Values below zero indicate a better fit than forced fusion. Under fixed sensory noise, the probabilistic cue-switching and causal-inference models fit reliably better than forced fusion; under free sensory noise the differences are small and the confidence intervals span zero.}}{14}{figure.10}\protected@file@percent }
\newlabel{fig:meanDeltaAIC}{{10}{14}{\textbf {Group-level model preference with participant bootstrap.} Mean per-participant $\Delta $AIC relative to the forced-fusion model (baseline $=0$, not shown) under fixed (left) and free (right) sensory noise. Black markers show the mean across participants with 95\% confidence intervals from $10{,}000$ participant bootstrap resamples; coloured points show individual participants. Values below zero indicate a better fit than forced fusion. Under fixed sensory noise, the probabilistic cue-switching and causal-inference models fit reliably better than forced fusion; under free sensory noise the differences are small and the confidence intervals span zero}{figure.10}{}}
\@writefile{toc}{\contentsline {subsubsection}{Switching probabilities increase with auditory noise}{14}{section*.28}\protected@file@percent }
\@LN@col{2}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Fitted switching probabilities increase with auditory noise.} Each thin line shows one participant's fitted probability of relying on the visual duration ($p_v$) in the low- and high-auditory-noise conditions, estimated from the probabilistic cue-switching model (free sensory-noise fits). The probability of relying on vision increased with auditory noise in $10$ of $11$ participants (group means $0.17 \rightarrow 0.51$; Wilcoxon signed-rank $p = 0.003$). Black line show group means $\pm $ SEM.}}{14}{figure.11}\protected@file@percent }
\newlabel{fig:switchingProb}{{11}{14}{\textbf {Fitted switching probabilities increase with auditory noise.} Each thin line shows one participant's fitted probability of relying on the visual duration ($p_v$) in the low- and high-auditory-noise conditions, estimated from the probabilistic cue-switching model (free sensory-noise fits). The probability of relying on vision increased with auditory noise in $10$ of $11$ participants (group means $0.17 \rightarrow 0.51$; Wilcoxon signed-rank $p = 0.003$). Black line show group means $\pm $ SEM}{figure.11}{}}
