\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Comparison of predicted optimal-integration variability with observed audiovisual variability.} Each panel compares empirically observed audiovisual variability ($\sigma _{AV}$; obtained by fitting psychometric functions to bimodal data, y-axis) with variability predicted by optimal reliability-weighted integration ($\sigma _{\mathrm  {opt}}$, x-axis), computed from unimodal psychometric-fit noise estimates ($\sigma _{a,h}$ and $\sigma _{a,\ell }$ for auditory high- and low-noise conditions, and $\sigma _v$ for vision). Each point is one participant; the dashed line indicates equality ($\sigma _{\mathrm  {opt}}=\sigma _{AV}$).}}{25}{figure.16}\protected@file@percent }
\newlabel{fig:optimalIntegrationComp}{{16}{25}{\textbf {Comparison of predicted optimal-integration variability with observed audiovisual variability.} Each panel compares empirically observed audiovisual variability ($\sigma _{AV}$; obtained by fitting psychometric functions to bimodal data, y-axis) with variability predicted by optimal reliability-weighted integration ($\sigma _{\mathrm {opt}}$, x-axis), computed from unimodal psychometric-fit noise estimates ($\sigma _{a,h}$ and $\sigma _{a,\ell }$ for auditory high- and low-noise conditions, and $\sigma _v$ for vision). Each point is one participant; the dashed line indicates equality ($\sigma _{\mathrm {opt}}=\sigma _{AV}$)}{figure.16}{}}
