\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  Conflict-dependent biases in auditory duration perception. Point of subjective equality (PSE) shifts as a function of audiovisual conflict for the low auditory-noise condition (\textbf  {A}) and high auditory-noise condition (\textbf  {B}), averaged over 11 participants. Positive values indicate biases toward longer perceived auditory duration. Red and blue show empirical data. Other lines indicate model predictions for forced fusion, causal inference, and probabilistic cue switching. The model predictions are jittered horizontally for readability. All model predictions were generated using sensory-noise parameters fitted using the bimodal data. Error bars reflect $\pm $~SEM across participant fits.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:pseConflictModel}{{8}{12}{Conflict-dependent biases in auditory duration perception. Point of subjective equality (PSE) shifts as a function of audiovisual conflict for the low auditory-noise condition (\textbf {A}) and high auditory-noise condition (\textbf {B}), averaged over 11 participants. Positive values indicate biases toward longer perceived auditory duration. Red and blue show empirical data. Other lines indicate model predictions for forced fusion, causal inference, and probabilistic cue switching. The model predictions are jittered horizontally for readability. All model predictions were generated using sensory-noise parameters fitted using the bimodal data. Error bars reflect $\pm $~SEM across participant fits}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Measured and predicted slope of psychometric functions. The slope $\sigma $ is shown in log-duration unit as a function of audiovisual conflict for the low auditory-noise condition (\textbf  {A}) and high auditory-noise condition (\textbf  {B}), averaged over 11 participants. Red and blue points show empirical data (group mean $\pm $~SEM across participants). Other lines indicate model predictions for forced fusion, causal inference, and probabilistic cue switching. Error bars indicate SEM across participants. Larger $\sigma $ values indicate lower duration-discrimination precision.}}{12}{figure.9}\protected@file@percent }
\newlabel{fig:sigmaConflictModel}{{9}{12}{Measured and predicted slope of psychometric functions. The slope $\sigma $ is shown in log-duration unit as a function of audiovisual conflict for the low auditory-noise condition (\textbf {A}) and high auditory-noise condition (\textbf {B}), averaged over 11 participants. Red and blue points show empirical data (group mean $\pm $~SEM across participants). Other lines indicate model predictions for forced fusion, causal inference, and probabilistic cue switching. Error bars indicate SEM across participants. Larger $\sigma $ values indicate lower duration-discrimination precision}{figure.9}{}}
